<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="derico.blicca.actionsblock">

  <browser:page
      name="aurora-block-actions"
      for="*"
      class=".actions_block_view.ActionsBlockView"
      template="actions_block_view.pt"
      permission="zope2.View"
      layer="derico.blicca.actionsblock.interfaces.IDericoBliccaActionsblockLayer"
      />

</configure>
