<nav xmlns:tal="http://xml.zope.org/namespaces/tal"
     tal:define="title view/title;
                 entries view/entries"
     tal:attributes="class view/root_class;
                     aria-label view/label">
  <!--! The Actions block's anatomy: the same markup
        `bundle-src/src/actions/ActionsView.tsx` emits. One scope-wrapped
        stylesheet dresses both surfaces, so an element added here without a
        peer there is a bug in both.

        Commentary must use the `!` form. Chameleon refuses an ASCII double
        hyphen anywhere inside a comment, and an ordinary HTML comment would
        ship to every visitor besides.

        The indentation below is stripped by `ActionsBlockView.__call__`; see
        its docstring for why an inter-element newline is not cosmetic here.

        The root is always emitted, with the EFFECTIVE category and its label;
        the heading and the list are each conditional on their own content, so
        a node with nothing to show is exactly one element. -->
  <h2 class="actions-title"
      tal:condition="title"
      tal:content="title">Title</h2>
  <ul class="actions-list" tal:condition="entries">
    <li tal:repeat="entry entries"
        tal:attributes="class entry/css"><a class="actions-link"
         tal:attributes="href entry/href"
         tal:content="entry/title">Title</a></li>
  </ul>
</nav>
