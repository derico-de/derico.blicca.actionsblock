<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="derico.blicca.actionsblock">

  <i18n:registerTranslations directory="locales" />

  <include file="permissions.zcml" />

  <genericsetup:registerProfile
      name="default"
      title="Derico Blicca Actionsblock"
      description="Aurora Actions block: renders one category of Plone actions (site actions, portal tabs, user, object actions) as a list of links"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="Derico Blicca Actionsblock (uninstall)"
      description="Uninstalls derico.blicca.actionsblock"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <genericsetup:importStep
      name="derico.blicca.actionsblock-uninstall"
      title="Derico Blicca Actionsblock uninstall"
      description="Uninstall derico.blicca.actionsblock"
      handler="derico.blicca.actionsblock.setuphandlers.uninstall"
      />


  <include package=".views" />

</configure>
